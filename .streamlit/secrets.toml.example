# ============================================================================
# secrets.toml — Streamlit secrets configuration
# ============================================================================
#
# This file is gitignored. Copy it to .streamlit/secrets.toml and fill in
# your real credentials.
#
# For Streamlit Community Cloud deployment, paste this same content into
# the "Secrets" section of your app's settings in the Streamlit Cloud
# dashboard — DO NOT commit the real credentials to Git.
# ============================================================================

[pega]
# OAuth client credentials from your Pega Personal Edition registration.
# Get these from Pega's Dev Studio: Records → Security → OAuth 2.0
# Client Registration → your registered client.
client_id = "REPLACE_WITH_YOUR_PEGA_CLIENT_ID"
client_secret = "REPLACE_WITH_YOUR_PEGA_CLIENT_SECRET"

[app]
# Demo password — gates the entire app. Anyone with the URL must enter
# this password before the chat UI loads.
#
# Pick something memorable but not guessable. You will type it once at the
# start of the demo. Tell only people you want to give live access.
demo_password = "REPLACE_WITH_YOUR_DEMO_PASSWORD"
